{
  "name": "mcp-server-memory-sqlite",
  "version": "0.9.0",
  "description": "MCP server for enabling memory for AI assistants through a knowledge graph",
  "homepage": "https://github.com/r14c/mcp-server-memory-sqlite/",
  "license": "Apache-2.0",
  "author": "Model Context Protocol (a Series of LF Projects, LLC.) ft. r14c",
  "repository": {
    "type": "git",
    "url": "https://github.com/r14c/mcp-server-memory-sqlite.git"
  },
  "bin": {
    "mcp-server-memory": "dist/index.js",
    "mcp-server-memory-web": "dist/web.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js dist/web.js",
