    "koa": "^3.2.1",
    "sqlite-up": "^0.6.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.8",
    "oxfmt": "^0.64.0",
    "shx": "^0.4.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.2.0"
  },
